# URL pública do site, usada para gerar links absolutos em cards de compartilhamento e metadados OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave PIX (aleatória) exibida na página "/apoie", com QR Code gerado em tempo de build.
# Não precisa do prefixo NEXT_PUBLIC_: é lida apenas em um Server Component, em build-time,
# e nunca é inlinada em JavaScript do cliente. Se não for definida, a seção de PIX é omitida.
PIX_KEY=

# Nome e cidade do recebedor, exibidos no app de quem paga ao escanear o QR Code Pix (campos
# obrigatórios do payload "Pix Copia e Cola" — padrão BR Code/EMV). Opcionais: se omitidos,
# assumem "Matheus" e "Sao Paulo", respectivamente. Sem acentos (são removidos automaticamente).
PIX_MERCHANT_NAME=
PIX_MERCHANT_CITY=
